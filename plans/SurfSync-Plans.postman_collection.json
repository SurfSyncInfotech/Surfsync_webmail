{
  "info": {
    "name": "SurfSync Mail Plans",
    "description": "Run from top to bottom. The public list needs no login. Creating, updating, and deactivating a plan uses the Super Admin token from the auth service.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4002" },
    { "key": "authUrl", "value": "http://localhost:4001" },
    { "key": "token", "value": "" },
    { "key": "planId", "value": "" }
  ],
  "item": [
    {
      "name": "1. List active plans",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "pm.test('Active plans returned', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(json.success).to.eql(true);",
              "  pm.expect(json.count).to.be.above(0);",
              "  pm.expect(json.plans[0]).to.have.property('monthlyPrice');",
              "  pm.expect(json.plans[0]).to.have.property('mailboxLimit');",
              "  pm.expect(json.plans[0]).to.have.property('storageGb');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/plans"
      }
    },
    {
      "name": "2. Login as Super Admin",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "pm.test('Super Admin logged in', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(json.success).to.eql(true);",
              "  pm.expect(json.user.role).to.eql('super_admin');",
              "  pm.collectionVariables.set('token', json.token);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@surfsync.test\",\n  \"password\": \"Admin12345\"\n}"
        },
        "url": "{{authUrl}}/auth/login"
      }
    },
    {
      "name": "3. Create plan",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "pm.test('Plan created', function () {",
              "  pm.response.to.have.status(201);",
              "  pm.expect(json.success).to.eql(true);",
              "  pm.expect(json.plan.status).to.eql('active');",
              "  pm.collectionVariables.set('planId', json.plan.planId);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"action\": \"create\",\n  \"name\": \"Growth\",\n  \"monthlyPrice\": 1999,\n  \"annualPrice\": 19990,\n  \"currency\": \"INR\",\n  \"mailboxLimit\": 25,\n  \"storageGb\": 200,\n  \"features\": [\"Webmail\", \"Priority support\"]\n}"
        },
        "url": "{{baseUrl}}/admin/plans"
      }
    },
    {
      "name": "4. Update plan",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "pm.test('Plan updated', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(json.success).to.eql(true);",
              "  pm.expect(json.plan.mailboxLimit).to.eql(30);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"action\": \"update\",\n  \"planId\": \"{{planId}}\",\n  \"name\": \"Growth\",\n  \"monthlyPrice\": 2499,\n  \"annualPrice\": 24990,\n  \"mailboxLimit\": 30,\n  \"storageGb\": 250,\n  \"features\": [\"Webmail\", \"Priority support\"]\n}"
        },
        "url": "{{baseUrl}}/admin/plans"
      }
    },
    {
      "name": "5. Deactivate plan",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "pm.test('Plan deactivated', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(json.success).to.eql(true);",
              "  pm.expect(json.plan.status).to.eql('inactive');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"action\": \"deactivate\",\n  \"planId\": \"{{planId}}\"\n}"
        },
        "url": "{{baseUrl}}/admin/plans"
      }
    },
    {
      "name": "6. Active list hides the deactivated plan",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "pm.test('Deactivated plan is hidden', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(json.success).to.eql(true);",
              "  const hidden = json.plans.some((item) => item.planId === pm.collectionVariables.get('planId'));",
              "  pm.expect(hidden).to.eql(false);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/plans"
      }
    }
  ]
}
